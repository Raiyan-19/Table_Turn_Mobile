# TableTurn Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/tableturn

# JWT Configuration
JWT_SECRET=tableturn_super_secret_jwt_key_production_grade_2026
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Authoritative Admin Email Allowlist (comma-separated for multiple admins)
ADMIN_EMAIL=admin@tableturn.app,raiyan@tableturn.app
